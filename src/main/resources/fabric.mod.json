{
  "schemaVersion": 1,
  "id": "multichat",
  "version": "${version}",
  "name": "MultiChat",
  "description": "Multi-panel tabbed chat for Minecraft. Filter, route, and organize messages across customizable panels with per-tab rules, badges, and timestamps.",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0-or-later",
  "icon": "assets/multichat/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.mobilelize.multichat.client.MultichatClient"
    ],
    "main": [
      "net.mobilelize.multichat.Multichat"
    ],
    "modmenu": [
      "net.mobilelize.multichat.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "multichat.mixins.json",
    {
      "config": "multichat.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "cloth-config": "*"
  }
}
